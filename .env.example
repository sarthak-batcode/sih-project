# ==============================================================================
# SIH26184 — configuration template.  Copy to .env and edit.
#   cp .env.example .env
# .env is gitignored; .env.example is committed and must never hold a real secret.
# ==============================================================================

ENVIRONMENT=development
PROJECT_NAME="Cybercrime Predictive Intelligence & Cash-Withdrawal Risk Dashboard"
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# JWT signing key — REQUIRED for anything but a local demo.
#
# The application ships with a development default that is committed to the repo,
# so anyone holding the source can mint valid tokens. main.py refuses to start
# with that default when ENVIRONMENT=production.
#
# Generate one:   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ------------------------------------------------------------------------------
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# Database. The project runs on SQLite out of the box — no server to install, and
# the schema is created at startup. A PostgreSQL URL also works; there is no
# migration tool wired up, so switching engines means recreating the schema.
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./cyber_intelligence.db
# DATABASE_URL=postgresql://user:password@localhost:5432/cyber_intelligence_db

# ------------------------------------------------------------------------------
# CORS. No wildcard: with allow_credentials=True browsers reject "*" anyway.
# 5173 = vite dev, 4173 = vite preview (production build).
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173","http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Default risk cut-offs for a fresh database. Once running, an administrator
# changes these through PATCH /api/v1/settings and the prediction endpoints pick
# the new values up on the next request.
# ------------------------------------------------------------------------------
RISK_THRESHOLD_CRITICAL=0.80
RISK_THRESHOLD_HIGH=0.65
RISK_THRESHOLD_MEDIUM=0.40

# ------------------------------------------------------------------------------
# Synthetic data generation
# ------------------------------------------------------------------------------
SYNTHETIC_RECORDS_COUNT=15000
SYNTHETIC_AREAS_COUNT=100
RANDOM_SEED=42
